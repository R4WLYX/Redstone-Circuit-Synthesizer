spec processing_unit_1 {
    input inst : S
    input data : S
  
    state reg[4] : S
  
    output reg(1)
    
    label clear_1
    label clear_2
    label clear_3
    label merge_12
    label merge_13
    label merge_24
    label merge_31
    label load_3
    label set_43
    label sub_32
  
    behavior {
        next reg(1) = switch inst {
            case clear_1: 0
            case merge_12: reg(1) | reg(2)
            case merge_13: reg(1) | reg(3)
            default: reg(1)
        }
        
        next reg(2) = switch inst {
            case clear_2: 0
            case merge_24: reg(2) | reg(4)
            default: reg(2)
        }
        
        next reg(3) = switch inst {
            case clear_3: 0
            case merge_31: reg(3) | reg(1)
            case load_3: data | reg(3)
            case sub_32: reg(3) - reg(2)
            default: reg(3)
        }
        
        next reg(4) = switch inst {
            case set_43: reg(3)
            default: reg(4)
        }
    }  
}